    "ai": "^7.0.163",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "linkedom": "^0.18.15",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
