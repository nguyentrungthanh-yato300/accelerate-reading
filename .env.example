# Copy to .env.local for local development. On Vercel, set the same variables in
# Project → Settings → Environment Variables.
# AI API keys are NOT configured here: each user enters their own in the app's Settings page.

# --- Database: Postgres (Neon on Vercel). Leave unset locally to use an embedded PGlite database
# in ./data/pglite. The Vercel–Neon integration sets DATABASE_URL for you.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Auth (Better Auth)
# Random secret for signing sessions: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The site's public URL, e.g. https://your-app.vercel.app (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000

# Sign-in providers (set at least one in production). Callback URLs to register:
#   Google: <BETTER_AUTH_URL>/api/auth/callback/google
#   GitHub: <BETTER_AUTH_URL>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Code a new user must enter to create an account (sign-up is invite-only).
INVITE_CODE=

# --- Encryption key for users' saved AI API keys: 32 random bytes, `openssl rand -base64 32`.
# Changing it makes saved keys unreadable (users re-enter them).
ENCRYPTION_KEY=
