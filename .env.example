# Copy to .env.local and fill in ONE provider.

# --- AI provider: google | anthropic | openai | ollama | openai-compatible
# If AI_PROVIDER is unset, the first API key found below is used.
AI_PROVIDER=google
# Optional model override (defaults: google=gemini-flash-latest, anthropic=claude-sonnet-5-5,
# openai=gpt-5.5, ollama=qwen3)
# AI_MODEL=

# Google Gemini (has a free tier): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Ollama (local, private, free) — run `ollama pull qwen3` first
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1

# Any OpenAI-compatible API (DeepSeek, OpenRouter, Groq, …)
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat

# --- Database (defaults to a local SQLite file). For Turso, use libsql://… plus a token.
# DATABASE_URL=file:./data/reading.db
# DATABASE_AUTH_TOKEN=
